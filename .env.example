# PLACEHOLDERS ONLY — copy to .env and set real values locally.
# .env is gitignored; never put real passwords or API keys in this file.
#
# NEO4J_PASSWORD must match the running instance (auth failures = wrong password).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# mock | grok_build | copilot | xai
NEO_PROVIDER=mock
NEO_MAX_STEPS=50
NEO_MAX_TOKENS=200000
NEO_REFLECT_EVERY_N=3
NEO_LOOP_ITERATIONS=20

# When using grok_build / copilot: allow tools during ACT (1/0)
NEO_ACT_ALLOW_TOOLS=0
# Optional working directory for provider CLI invocations
# NEO_PROVIDER_CWD=

# Named agent pack (agents/<id>/) — e.g. sysadmin for workstation IaC repos
# NEO_AGENT=sysadmin
# Workspace packs: $NEO_PROVIDER_CWD/agents is searched first
# NEO_AGENTS_DIR=~/.neo-harness/agents
# NEO_FULL_PERSONA=0
# NEO_PROMPT_MAX_CHARS_PLAN=4000
# NEO_PROMPT_MAX_CHARS_ACT=3000
# NEO_PROMPT_MAX_CHARS_REFLECT=2500
# NEO_EPISODE_TAIL=5
# NEO_OBSERVATION_TAIL=3

# Grok Build CLI
# GROK_BUILD_CMD=grok
# GROK_MODEL=
# NEO_GROK_TIMEOUT=180
# NEO_GROK_ACT_TURNS=8

# GitHub Copilot CLI (defaults in code: gpt-5-mini + effort low — thrifty)
# COPILOT_CMD=copilot
# COPILOT_MODEL=gpt-5-mini
# COPILOT_EFFORT=low
# NEO_COPILOT_TIMEOUT=300

# Direct xAI API
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest
