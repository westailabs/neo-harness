# Must match the Neo4j instance you actually run (auth failures = wrong password).
# Lab default on shurtugal often differs from "password" — check ~/neo4j/docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# mock | grok_build | copilot | xai
NEO_PROVIDER=mock
NEO_MAX_STEPS=50
NEO_MAX_TOKENS=200000
NEO_REFLECT_EVERY_N=3
NEO_LOOP_ITERATIONS=20

# When using grok_build / copilot: allow tools during ACT (1/0)
NEO_ACT_ALLOW_TOOLS=0
# Optional working directory for provider CLI invocations
# NEO_PROVIDER_CWD=

# Grok Build CLI
# GROK_BUILD_CMD=grok
# GROK_MODEL=
# NEO_GROK_TIMEOUT=180
# NEO_GROK_ACT_TURNS=8

# GitHub Copilot CLI
# COPILOT_CMD=copilot
# COPILOT_MODEL=
# COPILOT_EFFORT=low
# NEO_COPILOT_TIMEOUT=300

# Direct xAI API
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest
